// 数组、for、repeat、if-else、复合赋值
var a[5], i, s, n;
begin
  for i := 0 to 4 do a[i] := i * i;
  s := 0;
  for i := 0 to 4 do s += a[i];
  write('sum=', s);
  n := 0;
  repeat n += 1 until n >= 10;
  write('n=', n);
  if s > 100 then write('big') else write('small');
  i := 3;
  i++;
  i += 5;
  i--;
  write('i=', i, ' mod=', i % 4, ' sqrt=', sqrt(49));
  write('logic:', (i > 5) and (i < 100), (i > 100) or (i = 8))
end.
