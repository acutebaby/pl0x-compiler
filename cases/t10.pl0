/* 综合用例：冒泡排序（数组 + 双重 for + if + 复合赋值） */
var a[8], i, j, t, n;
begin
  n := 8;
  a[0] := 49; a[1] := 38; a[2] := 65; a[3] := 97;
  a[4] := 76; a[5] := 13; a[6] := 27; a[7] := 4;
  print('before:');
  for i := 0 to n - 1 do print(' ', a[i]);
  write('');
  for i := 0 to n - 2 do
    for j := 0 to n - 2 - i do
      if a[j] > a[j + 1] then
      begin
        t := a[j];
        a[j] := a[j + 1];
        a[j + 1] := t
      end;
  print('after :');
  for i := 0 to n - 1 do print(' ', a[i]);
  write('')
end.
